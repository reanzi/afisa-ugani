# Copied to .env by ./setup.sh. Fill DOMAIN and ACME_EMAIL; the secrets are
# generated for you.

# Base domain. DNS needs A records for api., site., field. and hq. under it
# (or one wildcard *.<domain>) pointing at this server's public IP.
DOMAIN=afisa.example.co.tz

# Let's Encrypt contact address.
ACME_EMAIL=you@example.co.tz

# Generated by setup.sh. Never change INSTANCE_SECRET after first start.
INSTANCE_SECRET=__GENERATE__
POSTGRES_PASSWORD=__GENERATE__

# Leave as latest for the demo, then pin (same tag for backend and dashboard).
CONVEX_VERSION=latest
