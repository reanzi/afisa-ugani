{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"]
    },
    "build": {
      "dependsOn": ["^typecheck", "typecheck"],
      "outputs": ["dist/**"],
      "env": ["VITE_CONVEX_URL", "VITE_APP_VERSION"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
